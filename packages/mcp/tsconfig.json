{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@aftercode/engine": ["../engine/dist/index.d.ts"],
      "@aftercode/shared": ["../shared/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
