GITHUB_TOKEN=ghp_your_personal_access_token_here

GEMINI_API_KEY=your_gemini_api_key_here

ENABLE_AI_LLM_SYNTHESIS=true

# ------------------------------------------
# 3. Local Audio Engine & Diagram APIs
# ------------------------------------------
# Local offline TTS model engine (Supertonic 3 local ONNX engine)
LOCAL_TTS_ENGINE=supertonic-3

# Napkin AI API Key for programmatic SVG flowchart visual generation (Optional)
NAPKIN_API_KEY=your_napkin_ai_api_key_here

# ------------------------------------------
# 4. Next.js & Server Settings
# ------------------------------------------
# Environment mode
NODE_ENV=development

# Next.js Server Port (Default: 3000)
PORT=3000


