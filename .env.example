# GitHub Personal Access Token (Optional but recommended for 5,000 req/hr rate limits & private repos)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Optional AI LLM Synthesis API Key (Gemini / OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
ENABLE_AI_LLM_SYNTHESIS=false

