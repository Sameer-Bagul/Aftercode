GITHUB_TOKEN=ghp_your_personal_access_token_here

GEMINI_API_KEY=your_gemini_api_key_here

ENABLE_AI_LLM_SYNTHESIS=true

# ------------------------------------------
# 3. Local Audio Engine (Zero-Cost TTS)
# ------------------------------------------
# Local offline TTS model engine (piper | espeak | system)
LOCAL_TTS_ENGINE=espeak

# Absolute or relative path to local Piper TTS binary (optional)
PIPER_TTS_PATH=/usr/bin/piper

# ------------------------------------------
# 4. Next.js & Server Settings
# ------------------------------------------
# Environment mode
NODE_ENV=development

# Next.js Server Port (Default: 3000)
PORT=3000

