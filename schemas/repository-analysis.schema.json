{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepositoryAnalysisPayload",
  "type": "object",
  "required": [
    "repoName",
    "detectedLanguages",
    "detectedManifests",
    "extractedEvidence",
    "classification"
  ],
  "properties": {
    "repoName": { "type": "string" },
    "detectedLanguages": { "type": "array", "items": { "type": "string" } },
    "detectedManifests": { "type": "array", "items": { "type": "string" } },
    "extractedEvidence": {
      "type": "object",
      "required": ["technologies", "configs", "features"],
      "properties": {
        "technologies": { "type": "array", "items": { "type": "string" } },
        "configs": { "type": "array", "items": { "type": "string" } },
        "features": { "type": "array", "items": { "type": "string" } }
      }
    },
    "classification": {
      "type": "object",
      "required": ["type", "portfolioWorthiness"],
      "properties": {
        "type": { "type": "string" },
        "portfolioWorthiness": { "type": "string" }
      }
    }
  }
}
